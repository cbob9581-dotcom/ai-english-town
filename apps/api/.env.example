# Copy to .env and fill in your values. .env is gitignored — never commit it.
# Settings.from_env() (apps/api/app/settings.py) loads this file automatically.

# LLM (DeepSeek / OpenAI-compatible). Required for real LLM; empty -> mock.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional overrides (see app/settings.py _ENV_FIELDS for the full list)
# LLM_TOTAL_TIMEOUT_NPC_S=15.0
# ENABLE_WORD_TIMESTAMPS=false
# PRONUNCIATION_GOP_ENABLED=false
